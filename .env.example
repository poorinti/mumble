# Copy this file to .env and replace every CHANGE_ME value before production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_8CHARS_MIN
FLASK_SECRET_KEY=CHANGE_ME_64_HEX_CHARACTERS
SESSION_COOKIE_SECURE=false
AI_BOT_TOKEN=CHANGE_ME_RANDOM_AI_BOT_TOKEN
CONTROL_API_TOKEN=CHANGE_ME_RANDOM_CONTROL_TOKEN

POSTGRES_DB=roip
POSTGRES_USER=roip
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
POSTGRES_POOL_SIZE=8

MUMBLE_ICE_SECRET=CHANGE_ME_RANDOM_ICE_SECRET
MUMBLE_IMAGE=mumblevoip/mumble-server:v1.5.915-1
ROIP_DOCKER_NETWORK=mumbledocker_roip-net
MUMBLE_MEMORY_LIMIT=512m
MUMBLE_CPU_LIMIT=1.0

RECORDS_DIR=/app/static/records
LEGACY_DB_FILE=/app/tactical.db
SERVERS_FILE=/app/servers.json
