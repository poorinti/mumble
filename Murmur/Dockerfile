FROM python:3.10

ENV DEBIAN_FRONTEND=noninteractive

# ??????????????????????????????
RUN apt-get update && apt-get install -y ffmpeg tzdata libopus0 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ?????????????????
RUN pip install --upgrade pip setuptools wheel

# ?????????????????? (????????????????)
RUN pip install --no-cache-dir zeroc-ice==3.7.11

# ?????????????????????
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ??????????????????
COPY . .

CMD ["python", "app.py"]